  m_Script: {fileID: 11500000, guid: b81b5922af194e589e04c89e6a161c76, type: 3}
  m_Name: Level Final Boss
  m_EditorClassIdentifier: Assembly-CSharp::LevelData
  levelName: Level Final Boss
  oneStarScore: 1000
  twoStarScore: 1300
  threeStarScore: 1600
  maxActiveSpaceships: 10
  chunks:
  - chunkName: Wait For VS Screen to Finish
    spawnInstructions: []
    useMaxActiveEnemies: 0
    maxActiveEnemies: 0
    useTimer: 1
    maxDuration: 4
    dialogueEnabled: 0
    dialogueLines: []
  - chunkName: Dialog
    spawnInstructions: []
    useMaxActiveEnemies: 1
    maxActiveEnemies: 0
    useTimer: 1
    maxDuration: 2
    dialogueEnabled: 1
    dialogueLines:
    - speaker: 0
      text: There you are...
      duration: 1
      waitForInput: 0
    - speaker: 1
      text: Captain Whiskers. I was wondering how long it would take you to catch
        up.
      duration: 2
      waitForInput: 0
    - speaker: 0
      text: You've been running long enough
      duration: 1
      waitForInput: 0
    - speaker: 1
      text: Running? No, Captain. I've been preparing.
      duration: 2
      waitForInput: 0
    - speaker: 0
      text: Then let's see what you've been preparing for.
      duration: 2
      waitForInput: 0
    - speaker: 1
      text: Oh. I think you'll find out soon enough.
      duration: 2
      waitForInput: 0
    - speaker: 1
      text: Try to keep up.
      duration: 1
      waitForInput: 0
  - chunkName: Boss
    spawnInstructions:
